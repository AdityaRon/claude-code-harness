{
  "_comment": [
    "Rules this repo once shipped and no longer does. The install merge only ever",
    "adds rules, so each install removes these from ~/.claude/settings.json; a",
    "local-settings fragment that lists one keeps it. Never list a rule here that",
    "the repo still ships."
  ],
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -rf /:*)",
      "Bash(git * push --force:*)",
      "Bash(git * push -f:*)",
      "Bash(git * reset --hard:*)",
      "Bash(git * clean -f:*)",
      "Bash(git * clean -fd:*)",
      "Bash(git * branch -D:*)",
      "Bash(git * branch -d:*)",
      "Bash(kubectl * delete:*)",
      "Bash(kubectl -n * delete:*)",
      "Bash(kubectl --context * delete:*)",
      "Bash(claude * --plugin-url:*)"
    ],
    "allow": []
  }
}
