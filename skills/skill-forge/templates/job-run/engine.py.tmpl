#!/usr/bin/env python3
"""{{name}}: {{question}}?

Archetype job-run, drafted by skill-forge on {{date}}. Each guard below is here
because the dangerous output is a clean-looking wrong answer; change one only
together with its test.

  {{module}}.py run --from-cronjob CJ --contexts a[,b,...] --namespace N [--name NAME]
                    [--timeout 30m] [--poll 10s] [--tail 100] [--apply]
  {{module}}.py run --manifest job.yaml --contexts a[,b,...] --namespace N [--apply]

A Job made with `kubectl create job --from=cronjob/CJ` copies the CronJob's own
template, so it cannot drift from what the schedule runs. Without --apply,
each cluster prints the Job it would create (a client-side dry run) and the
command, and nothing is created. With --apply it creates the Job, polls it
until it reaches Complete or Failed or --timeout passes, and prints the last
--tail log lines of one that failed or did not finish.

Guards: a context missing from the kubeconfig is SKIPPED and named, and the
header echoes the contexts and namespace. A CronJob that is not there is
ABSENT, with the ones that are. A kubectl auth error is AUTH for that cluster,
with ${{env_prefix}}_RELOGIN. A failed Job's logs are its end only because it
reached a terminal condition; a timeout prints them as a snapshot and is
PARTIAL. With more than one cluster, any that did not succeed makes the run
PARTIAL, and each cluster gets one result line.

Exit status: 0 every cluster succeeded (or the dry run), 1 the Job failed,
2 ABSENT, 3 PARTIAL or TIMEOUT, 4 AUTH, 5 REFUSED or SKIPPED.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mask import (EXIT_ABSENT, EXIT_AUTH, EXIT_OK, EXIT_PARTIAL, EXIT_REFUSED,  # noqa: E402
                  emit, header, iso, parse_duration)

ENV = "{{env_prefix}}"
DNS = re.compile(r"[a-z0-9]([-a-z0-9]*[a-z0-9])?")
AUTH = re.compile(r"(?i)must be logged in|unauthorized|token has expired|expired token|sso session"
                  r"|getting credentials: exec|executable \S+ failed|invalid_grant|reauthenticat")
SINGLE = {"FAILED": 1, "ABSENT": EXIT_ABSENT, "TIMEOUT": EXIT_PARTIAL, "AUTH": EXIT_AUTH, "SKIPPED": EXIT_REFUSED}
clock = time.monotonic
sleep = time.sleep


class Refused(Exception):
    pass


class AuthError(Exception):
    pass


def run_kubectl(argv: list[str], stdin: str | None = None, timeout: float = 600) -> tuple[int, str, str]:
    p = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def call(argv: list[str]) -> tuple[int, str, str]:
    rc, out, err = run_kubectl(argv)
    if rc != 0 and AUTH.search(err):
        raise AuthError(err.strip().splitlines()[-1][:200])
    return rc, out, err


def kube(argv: list[str]) -> str:
    rc, out, err = call(argv)
    if rc != 0:
        raise Refused(f"{shlex.join(argv[5:])} failed (exit {rc}): {err.strip()[:300]}")
    return out


def cronjob_exists(base: list[str], cj: str) -> bool:
    rc, _, err = call(base + ["get", "cronjob", cj, "-o", "name"])
    if rc == 0:
        return True
    if "NotFound" in err or "not found" in err:
        return False
    raise Refused(f"get cronjob {cj} failed (exit {rc}): {err.strip()[:300]}")


def watch(base: list[str], job: str, a) -> tuple[str | None, float]:
    """(Complete or Failed, seconds), or (None, seconds) at the timeout."""
    start = clock()
    deadline = start + parse_duration(a.timeout).total_seconds()
    while True:
        status = json.loads(kube(base + ["get", "job", job, "-o", "json"])).get("status", {})
        for c in status.get("conditions") or []:
            if c.get("type") in ("Complete", "Failed") and c.get("status") == "True":
                return c["type"], clock() - start
        if clock() >= deadline:
            return None, clock() - start
        sleep(parse_duration(a.poll).total_seconds())


def run_one(ctx: str, a, contexts: list[str], out: list[str], name: str) -> tuple[str, str]:
    base = ["kubectl", "--context", ctx, "--namespace", a.namespace]
    if ctx not in contexts:
        return "SKIPPED", "context absent from the kubeconfig"
    relogin = os.environ.get(f"{ENV}_RELOGIN", f"(set {ENV}_RELOGIN)")
    try:
        if a.from_cronjob:
            if not cronjob_exists(base, a.from_cronjob):
                there = [x.split("/")[-1] for x in kube(base + ["get", "cronjobs", "-o", "name"]).split()]
                return "ABSENT", f"no cronjob {a.from_cronjob} in {a.namespace}; cronjobs there: {', '.join(there) or 'none'}"
            create = base + ["create", "job", name, "--from=cronjob/" + a.from_cronjob]
        else:
            create = base + ["create", "-f", a.manifest]
        if not a.apply:
            out.append(f"--- {ctx}: would create:")
            out.extend(kube(create + ["--dry-run=client", "-o", "yaml"]).rstrip("\n").splitlines())
            out.append(f"would run: {shlex.join(create)}")
            return "DRY-RUN", "nothing created"
        job = kube(create + ["-o", "name"]).strip().split("/")[-1]
        state, waited = watch(base, job, a)
        if state == "Complete":
            return "SUCCEEDED", f"in {waited:.0f}s"
        logs = call(base + ["logs", "job/" + job, "--tail=" + str(a.tail), "--all-containers"])[1]
        if state == "Failed":
            out.append(f"--- {ctx}: last {a.tail} log lines of job/{job}; it reached Failed, so these are its end:")
            out.extend(logs.rstrip("\n").splitlines())
            return "FAILED", f"after {waited:.0f}s"
        out.append(f"--- {ctx}: job/{job} had not finished after {a.timeout}; a snapshot of its last {a.tail} log lines, "
                   "not the end of the run:")
        out.extend(logs.rstrip("\n").splitlines())
        return "TIMEOUT", f"still running after {a.timeout}; the logs above are a snapshot"
    except AuthError as e:
        return "AUTH", f"{e}. An expired login, not an empty answer; re-login: {relogin}"


def do_run(a) -> int:
    if bool(a.from_cronjob) == bool(a.manifest):
        raise Refused("give exactly one of --from-cronjob and --manifest")
    name = a.name or (f"{a.from_cronjob}-forge-{datetime.now(timezone.utc):%m%d%H%M}"[:63].rstrip("-") if a.from_cronjob else "")
    for n in [x for x in (name, a.from_cronjob, a.namespace) if x]:
        if not DNS.fullmatch(n) or len(n) > 63:
            raise Refused(f"{n!r} is not a Kubernetes name (lower case, digits and dashes, at most 63)")
    ctxs = [c for c in a.contexts.split(",") if c]
    contexts = kube(["kubectl", "config", "get-contexts", "-o", "name"]).split()
    started = iso(datetime.now(timezone.utc))
    out, results = [], []
    for ctx in ctxs:
        results.append((ctx, *run_one(ctx, a, contexts, out, name)))
    bad = [r for r in results if r[1] not in ("SUCCEEDED", "DRY-RUN")]
    source = f"cronjob/{a.from_cronjob}" if a.from_cronjob else f"manifest {a.manifest}"
    emit(header(f"contexts={','.join(ctxs)} namespace={a.namespace} job from {source}",
                f"n/a: runs now ({started}), each watched up to {a.timeout}", rows=f"{len(results)} cluster(s)",
                partial=f"{len(bad)} of {len(results)} cluster(s) did not succeed" if bad else None))
    for line in out:
        emit(line)
    for ctx, status, detail in results:
        emit(f"{ctx}: {status} {detail}")
    if not (a.apply or bad):
        emit("dry run: nothing created; pass --apply to create and watch the job")
    if not bad:
        return EXIT_OK
    if len(results) == 1:
        return SINGLE[results[0][1]]
    return EXIT_PARTIAL


def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 1)[1])
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--from-cronjob")
    r.add_argument("--manifest")
    r.add_argument("--contexts", required=True)
    r.add_argument("--namespace", required=True)
    r.add_argument("--name")
    r.add_argument("--timeout", default="30m")
    r.add_argument("--poll", default="10s")
    r.add_argument("--tail", type=int, default=100)
    r.add_argument("--apply", action="store_true", help="create the job; without it, print what would change")
    a = p.parse_args(argv)
    try:
        return do_run(a)
    except AuthError as e:
        relogin = os.environ.get(f"{ENV}_RELOGIN", f"(set {ENV}_RELOGIN to the command that renews access)")
        emit(f"AUTH: {e}. An expired login, not an empty answer. Re-login with: {relogin}", err=True)
        return EXIT_AUTH
    except (Refused, ValueError, OSError) as e:
        emit(f"REFUSED: {e}", err=True)
        return EXIT_REFUSED


if __name__ == "__main__":
    sys.exit(main())
