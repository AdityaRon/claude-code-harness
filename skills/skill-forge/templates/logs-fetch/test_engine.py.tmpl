"""Tests for {{module}}.py. The API is faked at fetch(), and the auth tests fake
urlopen; no test opens a connection.

Mutations that must turn this file red:
  no-stream-check: {{module}}.py: `if api("/loki/api/v1/series", {"match[]": sel, **span})["data"]:` => `if True:`
  no-label-check: {{module}}.py: `for label, value in EQ_MATCHER.findall(sel[1:-1]):` => `for label, value in []:`
  full-page-not-partial: {{module}}.py: `full = len(got) >= limit` => `full = False`
  no-pagination: {{module}}.py: `end = min(e[0] for e in got) + 1` => `break`
  warnings-ignored: {{module}}.py: `partial = list(warns)` => `partial = []`
  template-ignored: {{module}}.py: `tmpl = os.environ.get(f"{ENV}_SELECTOR_TEMPLATE", DEFAULT_TEMPLATE)` => `tmpl = DEFAULT_TEMPLATE`
  raw-selector-ok: {{module}}.py: `if not any(v for _, v in EQ_MATCHER.findall(sel)):` => `if False:`
  missing-namespace-ok: {{module}}.py: `    if missing:` => `    if False:`
  skew-unsaid: {{module}}.py: `if d > skew:` => `if False:`
  auth-html-missed: {{module}}.py: `if "html" in ctype or body.lstrip()[:1] == "<":` => `if False:`
  auth-401-missed: {{module}}.py: `if e.code in (401, 403):` => `if False:`
  creds-in-url-ok: {{module}}.py: `if "@" in urllib.parse.urlsplit(url).netloc:` => `if False:`
  token-in-url: {{module}}.py: `req.add_header("Authorization", "Bearer " + token)` => `req.full_url += "&token=" + token`
  filter-unescaped: {{module}}.py: `' |= "' + esc(filt) + '"'` => `' |= "' + filt + '"'`
  value-unescaped: {{module}}.py: `SLOT.sub(lambda m: esc(values[m.group(1)]), tmpl)` => `SLOT.sub(lambda m: values[m.group(1)], tmpl)`
  unmasked-lines: {{module}}.py: `emit(f"{stamp(ts)} {stream_label(labels)} {line}")` => `sys.stdout.write(f"{stamp(ts)} {stream_label(labels)} {line}\\n")`
"""
