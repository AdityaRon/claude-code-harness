"""Tests for {{module}}.py. psql is faked: no test opens a connection.

Mutations that must turn this file red:
  no-read-only-txn: {{module}}.py: `return f"BEGIN READ ONLY;` => `return f"BEGIN;`
  no-client-check: {{module}}.py: `ok, why = sqlguard.check(sql)` => `ok, why = True, ""`
  no-row-cap: {{module}}.py: `LIMIT {cap + 1}"` => `"`
  partial-hidden: {{module}}.py: `if len(data) > cap else None` => `if False else None`
  absent-as-error: {{module}}.py: `m = ABSENT.search(err)` => `m = None`
  empty-unsaid: {{module}}.py: `emit("EMPTY: the statement ran` => `(lambda *a: None)("EMPTY: the statement ran`
  auth-as-error: {{module}}.py: `        if AUTH.search(err):
            return auth_failed(err)` => ``
  expect-db-ignored: {{module}}.py: `if expect and who.get("db") != expect:` => `if False:`
  password-argv-ok: {{module}}.py: `if any(SECRET_ARG.search(a) for a in argv):` => `if False:`
  env-flag-password-ok: {{module}}.py: `r"(?i)pass" + r"word=` => `r"(?i)\bpass" + r"word=`
  flags-after-dbname: {{module}}.py: `return argv[:i] + PSQL_FLAGS + argv[i:]` => `return argv + PSQL_FLAGS`
  comment-swallows-wrapper: {{module}}.py: `body = f"SELECT * FROM (\\n{body}\\n)` => `body = f"SELECT * FROM ({body})`
  unmasked-rows: {{module}}.py: `    emit(buf.getvalue().rstrip("\\n"))` => `    sys.stdout.write(buf.getvalue())`
  superuser-unsaid: {{module}}.py: `if who.get("superuser") == "t" else ""` => `if False else ""`
"""
from __future__ import annotations

