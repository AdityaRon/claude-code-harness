#!/usr/bin/env python3
"""{{name}}: {{question}}?

Archetype cluster-probe, drafted by skill-forge on {{date}}. Each guard below is
here because the dangerous output is a clean-looking wrong answer; change one
only together with its test.

  {{module}}.py run --context C --namespace N --script FILE [--service-account SA]
                    [--image IMG] [--cpu 100m] [--memory 128Mi] [--ttl 10m] [--timeout 2m] [--apply]
  {{module}}.py cleanup --context C --namespace N [--apply]   delete probe pods a crash left behind

Without --apply, run prints the pod it would create and every kubectl command,
and changes nothing. With --apply it creates a throwaway pod that runs as the
service account's workload identity (no stored credential), waits for it, sends
the script on stdin to `sh -s`, and deletes the pod in a finally handler. The pod
also carries activeDeadlineSeconds, so the cluster kills it if this process dies.

Guards: the context must exist in the local kubeconfig (and match
${{env_prefix}}_EXPECT_CONTEXT, a regex, when set); the header names the context and
namespace. A probe pod left by an earlier run blocks a new one. The probe's
output counts only when it ends with the marker line `__PROBE_DONE__ rc=N`;
without it the capture is PARTIAL. A kubectl auth error is AUTH, with the
re-login command from ${{env_prefix}}_RELOGIN, never an empty answer.

Exit status: 0 probe ran and exited 0, 1 probe exited non-zero, 3 PARTIAL,
4 AUTH, 5 REFUSED.
"""
from __future__ import annotations

import argparse
import difflib
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
from datetime import datetime, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from mask import EXIT_AUTH, EXIT_OK, EXIT_PARTIAL, EXIT_REFUSED, emit, header, iso, parse_duration  # noqa: E402

ENV = "{{env_prefix}}"
NAME = "{{name}}"
LABEL = "skill-forge/probe"
TRAP = "trap 'echo \"__PROBE_DONE__ rc=$?\"' EXIT\n"
MARKER = re.compile(r"^__PROBE_DONE__ rc=(\d+)\s*$", re.M)
AUTH = re.compile(r"(?i)must be logged in|unauthorized|token has expired|expired token|refresh token|sso session"
                  r"|getting credentials: exec|executable \S+ failed|invalid_grant|reauthenticat")


class Refused(Exception):
    pass


class AuthError(Exception):
    pass


def run_kubectl(argv: list[str], stdin: str | None = None, timeout: float = 600) -> tuple[int, str, str]:
    p = subprocess.run(argv, input=stdin, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout, p.stderr


def kube(argv: list[str], stdin: str | None = None, check: bool = True) -> str:
    rc, out, err = run_kubectl(argv, stdin)
    if rc != 0 and AUTH.search(err):
        raise AuthError(err.strip().splitlines()[-1][:200])
    if rc != 0 and check:
        raise Refused(f"{shlex.join(argv[3:])} failed (exit {rc}): {err.strip()[:300]}")
    return out


def check_target(context: str) -> None:
    contexts = kube(["kubectl", "config", "get-contexts", "-o", "name"]).split()
    if context not in contexts:
        near = difflib.get_close_matches(context, contexts, n=3, cutoff=0.5)
        raise Refused(f"no context {context!r} in the kubeconfig" + (f"; closest: {', '.join(near)}" if near else ""))
    expect = os.environ.get(f"{ENV}_EXPECT_CONTEXT")
    if expect and not re.fullmatch(expect, context):
        raise Refused(f"context {context!r} does not match {ENV}_EXPECT_CONTEXT ({expect})")


def manifest(pod: str, a) -> dict:
    ttl = int(parse_duration(a.ttl).total_seconds())
    size = {"cpu": a.cpu, "memory": a.memory}
    return {
        "apiVersion": "v1", "kind": "Pod",
        "metadata": {"name": pod, "namespace": a.namespace, "labels": {LABEL: NAME}},
        "spec": {
            "serviceAccountName": a.service_account,
            "activeDeadlineSeconds": ttl,
            "restartPolicy": "Never",
            "containers": [{"name": "probe", "image": a.image, "command": ["sleep", str(ttl)],
                            "resources": {"requests": size, "limits": size}}],
        },
    }


def wrap(script: str) -> str:
    """The marker prints from an EXIT trap, so it is there only if the shell
    finished: a killed pod or a dropped stream leaves it out."""
    return TRAP + script


def leftovers(base: list[str]) -> list[str]:
    return kube(base + ["get", "pods", "-l", f"{LABEL}={NAME}", "-o", "name"]).split()


def show_plan(base: list[str], pod: str, a, script: str, tgt: str) -> int:
    emit(header(tgt, f"n/a: a point-in-time probe, planned at {iso(datetime.now(timezone.utc))}", rows="dry run"))
    emit(f"would create pod {pod}, deleted in a finally handler and by activeDeadlineSeconds:")
    emit(json.dumps(manifest(pod, a), indent=2))
    emit(f"would run: {shlex.join(base + ['create', '-f', '-'])}   (the manifest above on stdin)")
    emit(f"would run: {shlex.join(base + ['wait', '--for=condition=Ready', 'pod/' + pod, '--timeout=' + a.timeout])}")
    emit(f"would run: {shlex.join(base + ['exec', '-i', pod, '--', 'sh', '-s'])}   (the script on stdin, {len(script.splitlines())} lines)")
    emit(f"would run: {shlex.join(delete_cmd(base, pod))}")
    emit("dry run: nothing created; pass --apply to run the probe")
    return EXIT_OK


def delete_cmd(base: list[str], pod: str) -> list[str]:
    return base + ["delete", "pod", pod, "--wait=false", "--ignore-not-found"]


def do_run(a) -> int:
    script = open(a.script).read()
    base = ["kubectl", "--context", a.context, "--namespace", a.namespace]
    check_target(a.context)
    tgt = f"context={a.context} namespace={a.namespace} service-account={a.service_account} image={a.image}"
    left = leftovers(base)
    if left:
        raise Refused(f"a probe pod from an earlier run is still there ({', '.join(left)}); "
                      f"look at it, then: {{module}}.py cleanup --context {a.context} --namespace {a.namespace} --apply")
    pod = f"{NAME}-probe-{secrets.token_hex(3)}"
    if not a.apply:
        return show_plan(base, pod, a, script, tgt)
    started = iso(datetime.now(timezone.utc))
    kube(base + ["create", "-f", "-"], stdin=json.dumps(manifest(pod, a)))
    try:
        kube(base + ["wait", "--for=condition=Ready", "pod/" + pod, "--timeout=" + a.timeout])
        rc, out, err = run_kubectl(base + ["exec", "-i", pod, "--", "sh", "-s"], stdin=wrap(script))
        if rc and AUTH.search(err):
            raise AuthError(err.strip().splitlines()[-1][:200])
    finally:
        kube(delete_cmd(base, pod), check=False)
    done = MARKER.search(out)
    window = f"n/a: a point-in-time probe started {started}"
    lines = MARKER.sub("", out).rstrip("\n").splitlines()
    if done is None:
        emit(header(tgt, window, rows=len(lines), partial="no __PROBE_DONE__ marker: the output stops mid-probe"))
        for line in lines:
            emit(line)
        emit(f"PARTIAL: the capture is incomplete (kubectl exit {rc}{': ' + err.strip()[:200] if err.strip() else ''}); "
             "these lines are what arrived before it stopped")
        return EXIT_PARTIAL
    emit(header(tgt, window, rows=len(lines)))
    for out_line in lines:
        emit(out_line)
    probe_rc = int(done.group(1))
    if probe_rc:
        emit(f"the probe script exited {probe_rc}")
    return EXIT_OK if probe_rc == 0 else 1


def do_cleanup(a) -> int:
    base = ["kubectl", "--context", a.context, "--namespace", a.namespace]
    check_target(a.context)
    pods = leftovers(base)
    emit(header(f"context={a.context} namespace={a.namespace}", f"n/a: pods labelled {LABEL}={NAME} now", rows=len(pods)))
    for p in pods:
        emit(f"{'delete' if a.apply else 'would delete'} {p}")
    if not a.apply or not pods:
        emit("dry run: nothing deleted; pass --apply" if pods and not a.apply else "no probe pods left")
        return EXIT_OK
    for p in pods:
        kube(base + ["delete", p, "--wait=false", "--ignore-not-found"])
    return EXIT_OK


def main(argv=None) -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 1)[1])
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    c = sub.add_parser("cleanup")
    for sp in (r, c):
        sp.add_argument("--context", required=True)
        sp.add_argument("--namespace", required=True)
        sp.add_argument("--apply", action="store_true", help="make the change; without it, print what would change")
    r.add_argument("--script", required=True)
    r.add_argument("--service-account", default="default")
    r.add_argument("--image", default="alpine:3.20")
    r.add_argument("--cpu", default="100m")
    r.add_argument("--memory", default="128Mi")
    r.add_argument("--ttl", default="10m")
    r.add_argument("--timeout", default="2m")
    a = p.parse_args(argv)
    try:
        return do_run(a) if a.cmd == "run" else do_cleanup(a)
    except AuthError as e:
        relogin = os.environ.get(f"{ENV}_RELOGIN", f"(set {ENV}_RELOGIN to the command that renews access)")
        emit(f"AUTH: {e}. This is an expired login, not an empty answer. Re-login with: {relogin}", err=True)
        return EXIT_AUTH
    except (Refused, ValueError, OSError) as e:
        emit(f"REFUSED: {e}", err=True)
        return EXIT_REFUSED


if __name__ == "__main__":
    sys.exit(main())
