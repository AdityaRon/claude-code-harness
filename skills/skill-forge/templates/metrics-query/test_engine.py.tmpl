class AnalysisTest(unittest.TestCase):
    def vec(self, q):
        if q.startswith("avg by (version, tenant)"):
            rows = []
            for t, (a, b) in {"t1": (100, 80), "t2": (100, 90), "t3": (100, 120), "t4": (100, 70), "t5": (100, 101), "t6": (50, 25)}.items():
                rows += [{"metric": {"version": "v1", "tenant": t}, "value": [T_END, str(a)]},
                         {"metric": {"version": "v2", "tenant": t}, "value": [T_END, str(b)]}]
            rows.append({"metric": {"version": "v1", "tenant": "only-v1"}, "value": [T_END, "5"]})
            return rows
        if q.startswith("sum by (tenant)"):
            return [{"metric": {"tenant": t}, "value": [T_END, str(s)]} for t, s in {"t1": 1, "t2": 2, "t3": 30, "t4": 40, "t5": 500, "t6": 600}.items()]
        raise AssertionError(q)

    def test_ab_cohorts_by_version_pairs_and_buckets_by_size(self):
        rc, out, _ = Run(FakeApi(vector=self.vec))("ab", "latency", "--version-label", "version", "--a", "v1", "--b", "v2",
                                                   "--by", "tenant", "--size", "requests", *AT)
        self.assertEqual(rc, 0, out)
        self.assertIn("# rows:    6 pairs (7 on v1, 6 on v2)", out)
        self.assertRegex(out, r"small\s+2\s+1..2\s+0.850")
        self.assertRegex(out, r"large\s+2\s+500..600\s+0.755")
        self.assertIn("pooled median", out)

    def test_ab_absent_version_names_the_versions_seen(self):
        rc, out, _ = Run(FakeApi(vector=self.vec))("ab", "latency", "--version-label", "version", "--a", "v1", "--b", "v3", "--by", "tenant", *AT)
        self.assertEqual(rc, 2)
        self.assertIn('ABSENT: no series with version="v3"; versions seen: v1, v2', out)

    def test_ab_too_few_pairs_is_partial(self):
        rc, out, _ = Run(FakeApi(vector=self.vec))("ab", "latency", "--version-label", "version", "--a", "v1", "--b", "v2",
                                                   "--by", "tenant", "--min-pairs", "10", *AT)
        self.assertEqual(rc, 3)
        self.assertIn("PARTIAL: 6 entities ran both versions", out)

    def test_volume_step_voids_a_magnitude_when_the_input_moved(self):
        calls = []

        def vec(q):
            calls.append(q)
            n = len(calls)
            # before metric, after metric, before input, after input
            return [{"metric": {}, "value": [T_END, str({1: 10, 2: 20, 3: 100, 4: 200}[n])]}]
        rc, out, _ = Run(FakeApi(vector=vec))("volume-step", "errors", "--input", "requests", "--at", "2026-11-10T05:00:00Z")
        self.assertEqual(rc, 3)
        self.assertIn("VOID: the input moved +100%", out)
        self.assertIn("change=+0.0%", out.splitlines()[-1])

    def test_volume_step_stands_when_the_input_held(self):
        calls = []

        def vec(q):
            calls.append(q)
            return [{"metric": {}, "value": [T_END, str({1: 10, 2: 20, 3: 100, 4: 105}[len(calls)])]}]
        rc, out, _ = Run(FakeApi(vector=vec))("volume-step", "errors", "--input", "requests", "--at", "2026-11-10T05:00:00Z")
        self.assertEqual(rc, 0)
        self.assertIn("metric  before=10 after=20 change=+100.0%", out)
        self.assertNotIn("VOID", out)


def routed():
    """A direct route with no probe, for a test that calls fetch() itself."""
    class Routed:
        def __enter__(self):
            self.cm = eng.access.route(ENV, eng.base_url, None, [""])
            eng.ROUTE = self.cm.__enter__()

        def __exit__(self, *exc):
            eng.ROUTE = None
            return self.cm.__exit__(*exc)
    return Routed()


def answering(paths: dict, seen=None):
    """A fake urlopen that answers by URL path; any other path is a 404, as a wrong prefix is."""
    def urlopen(req, timeout):
        if seen is not None:
            seen.append(req)
        path = urllib.parse.urlsplit(req.full_url).path
        if path in paths:
            return FakeResponse(json.dumps(paths[path]).encode(), "application/json")
        if "*" in paths:
            return FakeResponse(json.dumps(paths["*"]).encode(), "application/json")
        raise urllib.error.HTTPError(req.full_url, 404, "Not Found", {"Content-Type": "text/plain"}, io.BytesIO(b"404 page not found"))
    return urlopen


class RouteTest(unittest.TestCase):
    OK = {"status": "success", "data": {"resultType": "vector", "result": []}}

    def test_guard_wrong_target_the_prefix_is_probed_and_echoed(self):
        paths = {"/prometheus/api/v1/query": self.OK,
                 "/prometheus/api/v1/status/buildinfo": {"status": "success", "data": {"version": "2.53.2"}},
                 "/prometheus/api/v1/query_range": {"status": "success", "data": {"resultType": "matrix",
                                                    "result": [series({"__name__": "up", "job": "api"}, [1, 1])]}}}
        seen = []
        with mock.patch("urllib.request.urlopen", answering(paths, seen)):
            rc, out, err = Run()("query", "up", "--window", "2m", *AT)
        self.assertEqual(rc, 0, err)
        self.assertEqual(out.splitlines()[0], "# target:  prometheus-compatible v2.53.2 at http://prom.test:9090 (direct) · "
                                              "prefix /prometheus (probed; no API at /: HTTP 404 from /api/v1/query: no API there)")
        self.assertEqual([urllib.parse.urlsplit(r.full_url).path for r in seen][:2], ["/api/v1/query", "/prometheus/api/v1/query"])

    def test_guard_wrong_target_a_prefix_answering_200_is_not_an_empty_answer(self):
        with mock.patch("urllib.request.urlopen", answering({"*": {}})):
            rc, out, err = Run()("query", "up", *AT)
        self.assertEqual(rc, 5)
        self.assertEqual(out, "")
        self.assertIn("no API answered at http://prom.test:9090 (direct) under any prefix tried", err)

    def test_a_pod_route_without_apply_creates_nothing(self):
        env = {f"{ENV}_ACCESS": "pod prom:9090 in monitoring", f"{ENV}_CONTEXT": "kind-test"}
        with mock.patch.object(eng.access, "kubectl", return_value=(0, "kind-test\n", "")) as k:
            rc, out, err = Run(env=env)("query", "up", *AT)
        self.assertEqual(rc, 5)
        self.assertIn("needs --apply", err)
        self.assertFalse(any("run" in c.args[0] for c in k.call_args_list))

    def test_guard_expired_auth_kube_login_is_auth_not_no_data(self):
        env = {f"{ENV}_ACCESS": "port-forward prom:9090 in monitoring", f"{ENV}_CONTEXT": "kind-test", f"{ENV}_RELOGIN": "kube-login"}
        gone = eng.access.AccessAuth("kubectl: error: You must be logged in to the server (Unauthorized)")
        with mock.patch.object(eng.access, "kubectl", side_effect=gone):
            rc, out, err = Run(env=env)("query", "up", *AT)
        self.assertEqual(rc, 4)
        self.assertEqual(out, "")
        self.assertIn("Re-login with: kube-login", err)


class FakeResponse:
    def __init__(self, body: bytes, ctype: str):
        self.body, self.headers = body, {"Content-Type": ctype}

    def read(self):
        return self.body

    def __enter__(self):
        return self

    def __exit__(self, *a):
        return False

    @classmethod
    def factory(cls, body, ctype, seen=None):
        def urlopen(req, timeout):
            if seen is not None:
                seen.append(req)
            return cls(body, ctype)
        return urlopen


class TransportTest(unittest.TestCase):
    def test_token_goes_in_a_header_not_the_url(self):
        seen = []
        body = json.dumps({"status": "success", "data": {"resultType": "matrix", "result": []}}).encode()
        with mock.patch("urllib.request.urlopen", FakeResponse.factory(body, "application/json", seen)), \
                mock.patch.dict(os.environ, {f"{ENV}_PROM_URL": "http://prom.test", f"{ENV}_PROM_TOKEN": "tok-123456789"}):
            with routed():
                eng.fetch("/api/v1/query_range", {"query": "up"})
        self.assertEqual(seen[0].get_header("Authorization"), "Bearer tok-123456789")
        self.assertNotIn("tok-123456789", seen[0].full_url)
        self.assertEqual(seen[0].get_method(), "GET")


