"""Tests for {{module}}.py. The API is faked at fetch(), and the auth tests fake
urlopen; no test opens a connection.

Mutations that must turn this file red:
  no-metric-check: {{module}}.py: `if not api("/api/v1/series", {"match[]": selector(metric), **span, "limit": "1"})["data"]:` => `if False:`
  no-label-check: {{module}}.py: `if not api("/api/v1/series", {"match[]": selector(metric, label, value), **span, "limit": "1"})["data"]:` => `if False:`
  warnings-ignored: {{module}}.py: `reasons = list(warn)` => `reasons = []`
  series-cap-ignored: {{module}}.py: `    if n > cap:` => `    if False:`
  series-api-warning-ignored: {{module}}.py: `partial = "; ".join(warn) if warn else (` => `partial = None if warn else (`
  auth-html-missed: {{module}}.py: `if "html" in ctype or body.lstrip()[:1] == "<":` => `if False:`
  auth-401-missed: {{module}}.py: `if status in (401, 403):` => `if False:`
  lag-unsaid: {{module}}.py: `lag.append(` => `(lambda *a: None)(`
  points-cap-off: {{module}}.py: `if points > MAX_POINTS:` => `if False:`
  creds-in-url-ok: {{module}}.py: `if "@" in urllib.parse.urlsplit(url).netloc:` => `if False:`
  token-in-url: {{module}}.py: `headers["Authorization"] = "Bearer " + token` => `q += "&token=" + token`
  label-unescaped: {{module}}.py: `+ '="' + esc(value) + '"}'` => `+ '="' + value + '"}'`
  by-labels-as-metrics: {{module}}.py: `if word.lower() in GROUPING and k < n and expr[k] == "(":` => `if False:`
  aggregations-as-metrics: {{module}}.py: `KEYWORDS = GROUPING | AGGREGATIONS |` => `KEYWORDS = GROUPING |`
  ab-unpaired: {{module}}.py: `pairs = sorted(set(a_vals) & set(b_vals))` => `pairs = sorted(set(a_vals) | set(b_vals))`
  ab-pooled-only: {{module}}.py: `buckets = [("all", ordered)] if not sizes else [` => `buckets = [("all", ordered)] if True else [`
  ab-few-pairs-ok: {{module}}.py: `partial = None if len(pairs) >= a.min_pairs else` => `partial = None if True else`
  void-never: {{module}}.py: `void = abs(moved) > a.tolerance` => `void = False`
  probe-skipped: {{module}}.py: `access.route(ENV, base_url, probe, PREFIXES, a.apply)` => `access.route(ENV, base_url, None, PREFIXES, a.apply)`
  404-unnamed: {{module}}.py: `    if status == 404:` => `    if False:`
  kube-auth-unmapped: {{module}}.py: `except (AuthError, access.AccessAuth) as e:` => `except AuthError as e:`
  route-refusal-unmapped: {{module}}.py: `except (Refused, ValueError, access.AccessRefused) as e:` => `except (Refused, ValueError) as e:`
  apply-ignored: {{module}}.py: `PREFIXES, a.apply) as ROUTE` => `PREFIXES, True) as ROUTE`
  unmasked-series: {{module}}.py: `emit(f"{labels(s['metric'])}  last=` => `sys.stdout.write(f"{labels(s['metric'])}  last=`
"""
