def series(metric: dict, values: list, last: float = T_END) -> dict:
    n = len(values)
    return {"metric": metric, "values": [[last - 60 * (n - 1 - i), str(v)] for i, v in enumerate(values)]}


class FakeApi:
    """Routes API paths to canned answers; records every call."""

    def __init__(self, result=None, warnings=None, known=None, label_values=None, vector=None, series_data=None, series_warn=None):
        self.result = result or []
        self.warnings = warnings or []
        self.known = known if known is not None else {"http_requests_total": [{"job": "api"}, {"job": "worker"}]}
        self.label_values = label_values or {}
        self.vector = vector or (lambda q: [])
        self.series_data, self.series_warn = series_data, series_warn
        self.calls = []

    def __call__(self, path, params):
        self.calls.append((path, params))
        if path == "/api/v1/status/buildinfo":
            return {"status": "success", "data": {"version": "2.53.2"}}
        if path == "/api/v1/query_range":
            return {"status": "success", "data": {"resultType": "matrix", "result": self.result}, **({"warnings": self.warnings} if self.warnings else {})}
        if path == "/api/v1/query":
            return {"status": "success", "data": {"resultType": "vector", "result": self.vector(params["query"])}}
        if path == "/api/v1/series":
            if self.series_data is not None and params.get("limit") != "1":
                return {"status": "success", "data": self.series_data, **({"warnings": self.series_warn} if self.series_warn else {})}
            sel = params["match[]"]
            metric = sel.split("{")[0]
            rows = self.known.get(metric, [])
            if "{" in sel:
                label, value = sel[len(metric) + 1:-1].split("=", 1)
                rows = [r for r in rows if r.get(label) == json.loads(value)]
            return {"status": "success", "data": rows[:1]}
        if path == "/api/v1/label/__name__/values":
            return {"status": "success", "data": NAMES}
        if path.startswith("/api/v1/label/"):
            label = path.split("/")[4]
            return {"status": "success", "data": self.label_values.get(label, [])}
        raise AssertionError(path)


class Run:
    def __init__(self, fake=None, env=None, patterns=()):
        self.fake, self.env, self.patterns = fake, env or {}, patterns

    def __call__(self, *argv):
        tmp = tempfile.TemporaryDirectory()
        cfg = Path(tmp.name) / "config.toml"
        cfg.write_text("[mask]\npatterns = " + json.dumps(list(self.patterns)) + "\n")
        env = {f"{ENV}_PROM_URL": "http://prom.test:9090", "SKILL_FORGE_CONFIG": str(cfg), **self.env}
        out, err = io.StringIO(), io.StringIO()
        mask._MASKER = None
        patches = [mock.patch.dict(os.environ, env)]
        if self.fake is not None:
            patches.append(mock.patch.object(eng, "fetch", self.fake))
        try:
            for p in patches:
                p.start()
            with redirect_stdout(out), redirect_stderr(err):
                rc = eng.main(list(argv))
        finally:
            for p in reversed(patches):
                p.stop()
            mask._MASKER = None
            tmp.cleanup()
        return rc, out.getvalue(), err.getvalue()


AT = ["--end", "2026-11-10T06:00:00Z"]


class QueryTest(unittest.TestCase):
    def test_golden_provenance_header_and_series(self):
        fake = FakeApi(result=[series({"__name__": "up", "job": "api"}, [1, 1, 0])])
        rc, out, _ = Run(fake)("query", "up", "--window", "2m", *AT)
        self.assertEqual(rc, 0)
        lines = out.splitlines()
        self.assertEqual(lines[0], "# target:  prometheus-compatible v2.53.2 at http://prom.test:9090 (direct) · prefix / not probed")
        self.assertEqual(lines[1], "# window:  2026-11-10T05:58:00Z .. 2026-11-10T06:00:00Z (UTC, bounds [start, end], step 60s)")
        self.assertTrue(lines[2].startswith("# command: "))
        self.assertEqual(lines[3:], ["# rows:    1 series", "# partial: no", 'up{job="api"}  last=0 min=0 max=1 avg=0.666667 points=3'])

    def test_selectors_skip_functions_grouping_labels_and_ranges(self):
        got = eng.selectors('sum by (job, code) (rate(http_requests_total{job="api", code=~"5.."}[5m])) / ignoring(code) up offset 5m')
        self.assertEqual(got, [("http_requests_total", [("job", "=", "api"), ("code", "=~", "5..")]), ("up", [])])
        self.assertEqual(eng.selectors('{__name__="up", job="x"}'), [("up", [("job", "=", "x")])])

    def test_quoting_a_label_value_with_a_quote_is_escaped(self):
        self.assertEqual(eng.selector("m", "path", 'a"b\\c'), 'm{path="a\\"b\\\\c"}')


class GuardTest(unittest.TestCase):
    def test_guard_absent_misspelled_metric(self):
        rc, out, _ = Run(FakeApi())("query", "rate(http_requets_total[5m])", *AT)
        self.assertEqual(rc, 2)
        self.assertIn("ABSENT: metric http_requets_total has no series in the window; did you mean http_requests_total?", out)

    def test_guard_absent_wrong_label_value(self):
        fake = FakeApi(label_values={"job": ["api", "worker"]})
        rc, out, _ = Run(fake)("instant", 'http_requests_total{job="apii"}', "--at", "2026-11-10T06:00:00Z")
        self.assertEqual(rc, 2)
        self.assertIn('ABSENT: no series of http_requests_total has job="apii"; closest: api', out)

    def test_guard_absent_and_empty_differ(self):
        rc, out, _ = Run(FakeApi())("query", 'rate(http_requests_total{job="api"}[30s])', *AT)
        self.assertEqual(rc, 0)
        self.assertIn("EMPTY: the series exist", out)
        self.assertNotIn("ABSENT", out)

    def test_guard_partial_backend_warning(self):
        fake = FakeApi(result=[series({"__name__": "up"}, [1])], warnings=["partial response: store unavailable"])
        rc, out, _ = Run(fake)("query", "up", *AT)
        self.assertEqual(rc, 3)
        self.assertIn("# partial: YES: partial response: store unavailable", out)

    def test_guard_partial_more_series_than_the_cap(self):
        fake = FakeApi(result=[series({"__name__": "up", "i": str(i)}, [i]) for i in range(3)])
        rc, out, _ = Run(fake)("query", "up", "--max-series", "2", *AT)
        self.assertEqual(rc, 3)
        self.assertIn("3 series, printed the first 2", out)
        self.assertNotIn('i="2"', out)

    def test_guard_partial_series_api_truncation_warning(self):
        fake = FakeApi(series_data=[{"__name__": "up", "job": "a"}], series_warn=["results truncated due to limit"])
        rc, out, _ = Run(fake)("series", "up", "--limit", "5", *AT)
        self.assertEqual(rc, 3)
        self.assertIn("PARTIAL: results truncated due to limit", out)

    def test_guard_expired_auth_401_is_not_no_data(self):
        def urlopen(req, timeout):
            raise urllib.error.HTTPError(req.full_url, 401, "Unauthorized", {"Content-Type": "text/plain"}, io.BytesIO(b"Unauthorized"))
        with mock.patch("urllib.request.urlopen", urlopen):
            rc, out, err = Run(env={f"{ENV}_RELOGIN": "sso-login metrics"})("query", "up", *AT)
        self.assertEqual(rc, 4)
        self.assertIn("Re-login with: sso-login metrics", err)
        self.assertEqual(out, "")

    def test_guard_expired_auth_html_login_page(self):
        with mock.patch("urllib.request.urlopen", FakeResponse.factory(b"<!doctype html><title>Sign in</title>", "text/html")):
            rc, _, err = Run()("query", "up", *AT)
        self.assertEqual(rc, 4)
        self.assertIn("login wall", err)

    def test_guard_window_is_utc_with_step(self):
        fake = FakeApi(result=[series({"__name__": "up"}, [1])])
        _, out, _ = Run(fake)("query", "up", "--window", "1h", "--step", "5m", "--end", "2026-11-09T22:00:00-08:00")
        self.assertIn("# window:  2026-11-10T05:00:00Z .. 2026-11-10T06:00:00Z (UTC, bounds [start, end], step 5m)", out)

